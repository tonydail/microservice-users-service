// This file is generated by Prisma — run `npm run db:generate` to regenerate.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique  // matches User.id in auth-service
  displayName String?
  avatarUrl   String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Transactional Outbox — written inside Prisma transactions alongside domain changes.
// Debezium reads this table via WAL (pgoutput) and publishes to Kafka.
// Never write to this table outside of a $transaction block.
model OutboxEvent {
  id          String   @id @default(uuid())
  aggregateId String   @map("aggregate_id")
  eventType   String   @map("event_type")
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("outbox_events")
}
